# Firebase Web SDK public configuration. Values are injected by GitHub Actions or local .env files.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_USE_FIREBASE_EMULATOR=false
VITE_GOOGLE_MAPS_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY must be a browser-restricted Maps JavaScript API key.
# Never place Admin SDK credentials, service-account JSON, Google Maps server keys,
# AI secrets, or server-side API secrets in VITE_ variables.